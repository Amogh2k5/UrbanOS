# AI Configuration
# Only 'openrouter' is supported by this build. Any other provider value leaves
# the AI layer disabled and the dashboard falls back to deterministic summaries.
URBANOS_LLM_API_KEY=
URBANOS_LLM_PROVIDER=openrouter
URBANOS_LLM_MODEL=liquid/lfm-2.5-2.6b:free
# Optional: override the OpenRouter base URL (proxies, gateways).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Data.gov.sg API key for accessing official datasets (HDB, Crime, Weather, etc.)
# Get one at: https://data.gov.sg/developer
DATA_GOV_SG_API_KEY=